# Copy to .env (cp .env.example .env) and change the secrets. .env is NOT committed.

# --- Servers ---
# Plain HTTP only redirects (308) to HTTPS
HTTP_PORT=5000
HTTPS_PORT=5443
# Relative to backend/ (generate with: docker compose run --rm backend npm run certs)
TLS_KEY_PATH=certs/key.pem
TLS_CERT_PATH=certs/cert.pem

# --- JWT ---
# At least 32 chars. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-change-me-change-me-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRES_IN=1h
JWT_ISSUER=article-backend
JWT_AUDIENCE=article-frontend

# --- Password hashing (argon2id) ---
# memoryCost in KiB. OWASP minimum: m=19456 (19 MiB), t=2, p=1
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
