meta {
  name: Login - wrong password
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{authEmail}}",
    "password": "wrong-password"
  }
}

assert {
  res.status: eq 401
  res.body.token: isUndefined
}

script:post-response {
  bru.setVar("wrongPasswordMessage", res.body.message);
}
