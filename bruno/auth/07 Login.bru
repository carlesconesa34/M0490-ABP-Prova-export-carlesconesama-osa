meta {
  name: Login
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{authEmail}}",
    "password": "{{authPassword}}"
  }
}

assert {
  res.status: eq 200
  res.body.token: isString
  res.body.user.email: eq {{authEmail}}
}

tests {
  test("returns a JWT (header.payload.signature)", function () {
    expect(res.body.token.split(".")).to.have.lengthOf(3);
  });

  test("returns the token and the public user only", function () {
    expect(res.getBody()).to.have.all.keys("token", "user");
    expect(res.body.user).to.have.all.keys("id", "email", "username");
  });

  test("JWT payload has no sensitive data and expires", function () {
    const payload = JSON.parse(atob(res.body.token.split(".")[1].replace(/-/g, "+").replace(/_/g, "/")));
    expect(payload).to.have.property("exp");
    expect(payload.sub).to.equal(String(res.body.user.id));
    const raw = JSON.stringify(payload);
    expect(raw).to.not.include(bru.getVar("authPassword"));
    expect(raw).to.not.include("$argon2");
  });

  test("never returns the password or its hash", function () {
    const raw = JSON.stringify(res.getBody());
    expect(raw).to.not.include(bru.getVar("authPassword"));
    expect(raw).to.not.include("$argon2");
    expect(raw.toLowerCase()).to.not.include("hash");
  });
}

script:post-response {
  bru.setVar("authToken", res.body.token);
}
