meta {
  name: Delete article
  type: http
  seq: 12
}

delete {
  url: {{baseUrl}}/articles/{{articleId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 204
}

tests {
  test("responds with an empty body", function () {
    expect(res.getBody()).to.satisfy(body => body === undefined || body === "" || body === null);
  });
}
