meta {
  name: Create article
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/articles
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "title": "Article de prova",
    "content": "Contingut de l'article de prova"
  }
}

assert {
  res.status: eq 201
  res.body.id: isNumber
  res.body.title: eq Article de prova
}

script:post-response {
  // Save the new article for the next requests
  bru.setVar("articleId", res.body.id);
  bru.setVar("articleContent", res.body.content);
}
